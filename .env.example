# Day configuration. Copy to .env or run `day setup` to generate one.
# 0.0.0.0 is required when Caddy runs in Docker and proxies to the host.
DAY_HOST=127.0.0.1
DAY_PORT=3037
# DAY_BASE_URL=https://day.home.br11k.dev
DAY_TZ=Europe/Warsaw
DAY_USER=day
DAY_PASSWORD=change-me
DAY_READ_TOKEN=change-me-too
DAY_CADDY_HOST=day.home.br11k.dev
# This host uses the existing `proxy` network.
DAY_CADDY_NETWORK=caddy
DAY_COVERAGE_THRESHOLD=0.9
DAY_ADHERENCE_THRESHOLD=0.8
DAY_GOAL_HOURS=3
